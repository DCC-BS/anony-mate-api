# This env file uses @env-spec - see https://varlock.dev/env-spec for more info
# @defaultRequired=true @defaultSensitive=false
# @import(./.env.dev.schema, enabled=eq($APP_MODE, "dev"))
# ----------

# The app mode controls the varlock validation:
# on dev all env variables get validated
# on build only the for build required variables get validated (good for docker build)
# on prod only the runtime required variables get validated (good for docker run)
# @type=enum(dev, ci, build, prod)
APP_MODE=dev

# @type=enum(debug, trace, info, warn, error, fatal, DEBUG, TRACE, INFO, WARN, ERROR, FATAL)
LOG_LEVEL=ifs(
    eq($APP_MODE, dev), debug,
    eq($APP_MODE, ci), debug,
    eq($APP_MODE, build), info,
    eq($APP_MODE, prod), info,
    debug
)

# The model for LLM API
# @type=string
LLM_MODEL='Qwen/Qwen3-32B-AWQ'

## Ports

# The port of the fastapi backend app
# @type=port
PORT=8000

# @type=port
LLM_API_PORT=8001

# @type=port
CLIENT_PORT=3000

# @type=port
GLINER_PORT=8081

# @type=port
DOCLING_API_PORT=5001

## Urls

# The URL for client application
# @type=url
CLIENT_URL=if(
    eq($APP_MODE, "dev"), http://localhost:${CLIENT_PORT}, )

# The URL for LLM API
# @type=url
LLM_URL=if(
    eq($APP_MODE, "dev"), "http://localhost:${LLM_API_PORT}/v1", )

# The URL for LLM health check API
# @type=url
LLM_HEALTH_CHECK_URL=if(
    eq($APP_MODE, "dev"), "http://localhost:${LLM_API_PORT}/health", )

# The URL for the glen api
# @type=url
GLINER_API_BASE_URL=if(
    eq($APP_MODE, "dev"), "http://localhost:${GLINER_PORT}",
)

# HTTP timeout in seconds for Gliner API calls. A full-document chunk scan runs
# roughly 1.2s per 1000 characters, so this has to allow for minutes, not seconds.
# @type=number
GLINER_HTTP_TIMEOUT_SECONDS=600

# Interval in seconds between Gliner task status polls.
# @type=number
GLINER_POLL_INTERVAL_SECONDS=3

# Seconds to wait for a whole Gliner extraction task. Polling keeps each
# request short, so this bounds the scan itself, not one call.
# @type=number
GLINER_TASK_TIMEOUT_SECONDS=3600

DOCLING_URL=if(
    eq($APP_MODE, "dev"), "http://localhost:${DOCLING_API_PORT}/v1",
)

# Interval in seconds between Docling task status polls.
# @type=number
DOCLING_POLL_INTERVAL_SECONDS=3

# Seconds to wait for a Docling conversion to finish. Large scanned PDFs run
# OCR page by page, so this is minutes rather than seconds.
# @type=number
DOCLING_CONVERSION_TIMEOUT_SECONDS=1800

# Per-request HTTP timeout for Docling calls. Covers uploading the file, which
# is itself slow for large documents.
# @type=number
DOCLING_HTTP_TIMEOUT_SECONDS=300

# Docling PDF parsing backend: pypdfium2 (faster) or docling_parse (more thorough).
# @type=enum(pypdfium2, docling_parse)
DOCLING_PDF_BACKEND=pypdfium2

# Docling table structure mode: accurate reads tables properly, fast skips detail.
# @type=enum(accurate, fast)
DOCLING_TABLE_MODE=accurate

# Conversions the API runs at once. Docling serves two at a time and cannot be
# changed from here, so the backlog is held in this API — where it can be
# positioned, interleaved fairly between clients and dropped — rather than
# pushed into Docling's unbounded queue.
# @type=number
CONVERSION_MAX_CONCURRENT=3

# Conversions allowed to wait before submissions are refused with 429.
# @type=number
CONVERSION_MAX_QUEUED=16

# Redactions the API runs at once. GLiNER batches on the GPU and measured flat
# at 32 concurrent, so this is generous on purpose.
# @type=number
REDACTION_MAX_CONCURRENT=32

# Redactions allowed to wait before submissions are refused with 429.
# @type=number
REDACTION_MAX_QUEUED=256

# Largest accepted upload, in bytes. A queued document is held in memory until
# a worker converts it, so this bound times CONVERSION_MAX_QUEUED is the most
# the queue can ever hold.
# @type=number
MAX_UPLOAD_BYTES=104857600

# A queued task nobody has polled for this long is dropped before it is handed
# to a worker. Docling cannot recall work once started, so this is the only
# point where a vanished caller's document can still be dropped.
# @type=number
TASK_ABANDONED_AFTER_SECONDS=60

# Seconds an abandoned task and its result are kept before the store drops them.
# @type=number
TASK_RESULT_TTL_SECONDS=3600

## Secrets

# @sensitive=eq($APP_MODE, "prod")
GLINER_API_KEY=none

# @sensitive=eq($APP_MODE, "prod")
DOCLING_API_KEY=none

# The API key for authenticating with the LLM
# @sensitive=eq($APP_MODE, "prod")
LLM_API_KEY=none

## Flags

# Flag to indicate if the environment is production used for the logger
# @type=boolean
IS_PROD=eq($APP_MODE, "prod")

# Send the text to Gliner as an uploaded file instead of a JSON field, so a
# firewall between the two services sees an ordinary upload, not one very
# large JSON string. Set to false to fall back to the JSON endpoint.
# @type=boolean
GLINER_USE_BINARY_UPLOAD=true

## Caching dirs for docker
# ---

# home directory should be set on linux
# @required
HOME=
CACHE_DIR="${HOME}/cache"
HUGGING_FACE_CACHE_DIR=${CACHE_DIR}/huggingface

# only needed for the VLLM docker container
# @optional @sensitive
HUGGING_FACE_HUB_TOKEN=
